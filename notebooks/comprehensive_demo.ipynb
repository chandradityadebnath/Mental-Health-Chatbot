# Cell 4: Interactive Demo
def interactive_demo():
    print("💬 Mental Health Agent Interactive Demo")
    print("Type 'quit' to exit\n")
    
    while True:
        user_input = input("You: ")
        
        if user_input.lower() in ['quit', 'exit', 'bye']:
            print("Agent: Thank you for chatting. Remember to prioritize your mental health! 💙")
            break
        
        # Get agent response
        result = agent.chat(user_input)
        
        print(f"\nAgent: {result['response']}")
        print(f"\n[Analysis] Risk Level: {result['analysis']['risk_assessment']['level']}")
        print(f"[Analysis] Primary Emotion: {result['analysis']['emotion_breakdown'][0]['label']}")
        print("-" * 60)

# Run interactive demo
interactive_demo()

